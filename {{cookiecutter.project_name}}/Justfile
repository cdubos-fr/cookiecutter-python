set shell := ["zsh", "-uc"]

default:
    @just --list

# Build virtual environment for development
devenv:
    @echo "Setting up development environment uv"
    @uv venv --allow-existing .venv
    @uv sync
    @source .venv/bin/activate; prek install || true
    @echo "✓ Development environment ready"

# Run all checks
checks:
    @echo "Running dedicated hooks"
    -@uv run prek run trailing-whitespace end-of-file-fixer \
    check-yaml check-toml debug-statements \
    check-merge-conflict  mixed-line-ending
    @echo "Running Tox checks"
    @tox -q

# Run tests
test:
    @tox -e test -q

# Run type checking
types:
    @tox -e types -q

# Run formatters
format:
    @uv run ruff format
    @uv run ssort
    @uv run zizmor --fix=all

# Run linters
lint:
    @tox -e lint -q

# Build the documentation
docs:
    @uv run zensical build

# Serve the docs
docs-serve:
    @uv run zensical serve

# Clear cache and temporary files
clean:
    @find . -type d -name .venv -exec rm -rf {} +
    @find . -type d -name __pycache__ -exec rm -rf {} +
    @find . -type d -name .ruff_cache -exec rm -rf {} +
    @find . -type d -name dist -exec rm -rf {} +
    @find . -type d -name build -exec rm -rf {} +
    @find . -type d -name .pytest_cache -exec rm -rf {} +
    @find . -type d -name "*.egg-info" -exec rm -rf {} +
    @find . -type d -name .mypy_cache -exec rm -rf {} +
    @find . -type d -name .tox -exec rm -rf {} +
    @find . -type d -name site -exec rm -rf {} +
    @find . -type f -name .coverage -exec rm -rf {} +
    @find . -type d -name result -exec rm -rf {} +

# Build package
build:
    @uv build

# Bump version
release-version:
    @uv run cz bump
